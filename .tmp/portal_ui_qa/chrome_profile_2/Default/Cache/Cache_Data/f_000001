  <!-- Dynamic Font Engine: Áp dụng font tức thì không cần reload hay sửa code -->
  <script>
    (function() {
      window.ensureGoogleFontLoaded = function(fontName) {
        if (!fontName) return;
        var fontSlug = fontName.replace(/\s+/g, '+');
        var linkId = 'gfont-dynamic-' + fontName.toLowerCase().replace(/[^a-z0-9]/g, '-');
        if (!document.getElementById(linkId)) {
          var link = document.createElement('link');
          link.id = linkId;
          link.rel = 'stylesheet';
          link.href = 'https://fonts.googleapis.com/css2?family=' + fontSlug + ':ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap';
          document.head.appendChild(link);
        }
      };

      window.applyFontGlobally = function(fontObj, persist) {
        if (!fontObj || !fontObj.name) return;
        window.ensureGoogleFontLoaded(fontObj.name);
        var familyStr = "'" + fontObj.name + "', 'Microsoft JhengHei', '微軟正黑體', -apple-system, BlinkMacSystemFont, sans-serif, serif";
        document.documentElement.style.setProperty('--font-sans', familyStr);
        document.documentElement.style.setProperty('--font-serif', familyStr);
        document.body && (document.body.style.fontFamily = familyStr);

        if (persist !== false) {
          try {
            localStorage.setItem('hm_portal_active_font', JSON.stringify(fontObj));
            // Gửi lưu về backend server
            fetch('/api/v1/fonts/active', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(fontObj)
            }).catch(function(e) { console.warn('Could not persist font to server:', e); });
          } catch(e) {}
        }
      };

      // Tự động kích hoạt ngay khi mở trang
      try {
        var rawSaved = localStorage.getItem('hm_portal_active_font');
        if (rawSaved) {
          var parsed = JSON.parse(rawSaved);
          if (parsed && parsed.name) {
            window.ensureGoogleFontLoaded(parsed.name);
            var familyStr = "'" + parsed.name + "', 'Microsoft JhengHei', '微軟正黑體', -apple-system, BlinkMacSystemFont, sans-serif, serif";
            document.documentElement.style.setProperty('--font-sans', familyStr);
            document.documentElement.style.setProperty('--font-serif', familyStr);
          }
        }
      } catch(e) {}
    })();
  </script>
  
